{
  "openapi": "3.1.0",
  "info": {
    "title": "Lowdown API",
    "description": "Lowdown records two kinds of data, kept separate: (1) interactions that agents report after using a tool or service, and (2) Lowdown Scanner observations of MCP Registry servers — a time-series record of the gap between what the official MCP Registry declares and what is actually observed. It records what changed and when; it does not score, grade, or rank servers. Public dataset and daily report: https://github.com/PetShopBros/lowdown-data For records of many servers, use the daily dataset at https://github.com/PetShopBros/lowdown-data (CC BY 4.0) instead of calling the lookup once per server; each lookup response carries a Link header to it.",
    "version": "0.1.18",
    "license": {
      "name": "Scanner data: CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    }
  },
  "servers": [
    {
      "url": "https://lowdown-proxy.vercel.app"
    }
  ],
  "paths": {
    "/api/reputation/{target}": {
      "get": {
        "operationId": "getReputation",
        "summary": "Get the Registry declaration, Scanner observations, and reported interactions for a target",
        "description": "Returns what Lowdown has recorded about a target, in this order: (1) `registry`: what the official MCP Registry declares for it, as recorded by Lowdown since 2026-10-19, with changes in the last 30 days; (2) `scanner`: what Lowdown Scanner observed (initialize + tools/list only), including one entry per day for the last 30 days, days without an observation and why, and the observed tool names; (3) interactions reported by agents. These are facts with their sources, not scores. Short names resolve when they match one target; otherwise candidate names are returned.",
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier of the target: an MCP Registry name with the mcp: prefix, e.g. 'mcp:ai.agent-bev/bev-door' (the '/' may be sent as is or as %2F), a short name such as 'bev-door', or another id such as 'agent:some-agent-id'."
          },
          {
            "name": "task_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Limit interaction figures to one task type. Scanner data is not returned for task-filtered requests."
          },
          {
            "name": "ref",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,64}$"
            },
            "description": "Optional referral tag used to measure where lookups come from."
          }
        ],
        "responses": {
          "200": {
            "description": "Reputation data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "resolved_target": {
                      "type": "string",
                      "description": "Registry name the lookup resolved to, with the mcp: prefix."
                    },
                    "message": {
                      "type": "string",
                      "description": "One factual sentence: whether a Registry record, Scanner observations, and reported interactions exist, and, for observed servers, when tool definitions last changed."
                    },
                    "registry": {
                      "type": "object",
                      "description": "Declared facts from the official MCP Registry as recorded by Lowdown (records kept since 2026-10-19). `listed: false` with a note when no record matches.",
                      "properties": {
                        "listed": {
                          "type": "boolean",
                          "description": "true when the entry is in the Registry as of the latest record."
                        },
                        "name": {
                          "type": "string"
                        },
                        "declared_version": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "status": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "enum": [
                            "active",
                            "deprecated",
                            "deleted",
                            null
                          ]
                        },
                        "removed_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time",
                          "description": "When Lowdown recorded the entry as gone from the Registry list."
                        },
                        "remote_hosts": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "declares_packages": {
                          "type": "boolean"
                        },
                        "first_recorded_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "recorded_since_baseline": {
                          "type": "boolean",
                          "description": "true for entries already present in Lowdown's first Registry snapshot (2026-10-19); first_recorded_at is then not when the entry first appeared in the Registry."
                        },
                        "changes_30d": {
                          "type": "array",
                          "description": "Registry changes detected in the last 30 days, newest first (max 20). old/new are given for version and status changes.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "on": {
                                "type": "string",
                                "format": "date"
                              },
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "new",
                                  "removed",
                                  "restored",
                                  "version",
                                  "status",
                                  "remotes",
                                  "packages",
                                  "description"
                                ]
                              },
                              "old": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "new": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            }
                          }
                        },
                        "note": {
                          "type": "string"
                        }
                      }
                    },
                    "registry_candidates": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Returned instead of `registry` when a short name matches several Registry names."
                    },
                    "scanner": {
                      "type": "object",
                      "description": "Observations by Lowdown Scanner (initialize + tools/list only; no tool calls). Separate from interaction data; not included in success_rate. When the target is outside the Scanner's fixed sample of daily-observed MCP Registry entries (5,000 from 2026-10-19, 2,000 before), this block contains only `observed: false` and a note; absence of data says nothing about the target's status.",
                      "properties": {
                        "observed": {
                          "type": "boolean",
                          "description": "false when no Scanner observation exists for this target."
                        },
                        "note": {
                          "type": "string"
                        },
                        "target": {
                          "type": "string"
                        },
                        "last_observed_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "observations_30d": {
                          "type": "integer"
                        },
                        "remotes_observed": {
                          "type": "integer"
                        },
                        "latest": {
                          "type": "object",
                          "properties": {
                            "reached_level": {
                              "type": "integer",
                              "enum": [
                                0,
                                1,
                                2
                              ],
                              "description": "0 = initialize failed, 1 = initialize ok, 2 = initialize + tools/list ok"
                            },
                            "http_status": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "error_type": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "latency_ms": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "tool_count": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "schema_hash": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "server_version": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          }
                        },
                        "schema_versions_30d": {
                          "type": "integer"
                        },
                        "status_distribution_30d": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer"
                          }
                        },
                        "in_sample": {
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "description": "Whether the target is in a Scanner cohort."
                        },
                        "cohorts": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "first_observed_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time",
                          "description": "First observation of this target by Lowdown Scanner."
                        },
                        "definition_changes": {
                          "type": "object",
                          "description": "Changes in the server's tool definitions in Lowdown's daily observations of the last 30 days. Each day's observation is compared with the previous one from the same remote URL, using hashes of tool schemas, descriptions and names; description text is never returned. Facts only: no score or risk level.",
                          "properties": {
                            "pattern": {
                              "type": "string",
                              "enum": [
                                "not_enough_observations",
                                "no_change_observed",
                                "changed",
                                "changes_on_most_days"
                              ],
                              "description": "`changes_on_most_days`: definitions changed on at least half of at least 4 compared days, so a single change is routine for this server."
                            },
                            "observed_days": {
                              "type": "integer",
                              "description": "Days with a complete tools/list observation (reached_level 2)."
                            },
                            "compared_days": {
                              "type": "integer",
                              "description": "Days that could be compared with an earlier observation from the same remote."
                            },
                            "change_days": {
                              "type": "integer",
                              "description": "Compared days on which a schema, description or tool name hash differed."
                            },
                            "first_compared_day": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "format": "date"
                            },
                            "last_change": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "format": "date"
                            },
                            "days_since_last_change": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "description": "Days from last_change to the latest observed day."
                            },
                            "stable_days_before_last_change": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "description": "Days from the previous change (or the first observed day) to last_change."
                            },
                            "events": {
                              "type": "array",
                              "description": "Up to 5 most recent changes, newest first.",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "day": {
                                    "type": "string",
                                    "format": "date"
                                  },
                                  "kinds": {
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "enum": [
                                        "schema_changed",
                                        "description_changed",
                                        "tool_names_changed",
                                        "server_version_changed"
                                      ]
                                    }
                                  },
                                  "tool_count": {
                                    "type": "object",
                                    "properties": {
                                      "from": {
                                        "type": "integer"
                                      },
                                      "to": {
                                        "type": "integer"
                                      }
                                    }
                                  },
                                  "server_version": {
                                    "type": "object",
                                    "properties": {
                                      "from": {
                                        "type": "string"
                                      },
                                      "to": {
                                        "type": "string"
                                      }
                                    }
                                  },
                                  "returned_to_earlier_definition": {
                                    "type": "boolean",
                                    "description": "The new definition equals one observed earlier from the same remote."
                                  },
                                  "compared_with": {
                                    "type": "string",
                                    "format": "date"
                                  },
                                  "remote_host": {
                                    "type": [
                                      "string",
                                      "null"
                                    ],
                                    "description": "Present only when the server has several remotes."
                                  }
                                }
                              }
                            },
                            "note": {
                              "type": "string"
                            },
                            "basis": {
                              "type": "string"
                            }
                          }
                        },
                        "daily_30d": {
                          "type": "array",
                          "description": "One entry per UTC day with an observation in the last 30 days. When a target has several remotes, the entry with the highest reached_level is shown and `remotes` counts them.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "day": {
                                "type": "string",
                                "format": "date"
                              },
                              "reached_level": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "http_status": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "error_type": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "tool_count": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "tools_changed": {
                                "type": [
                                  "boolean",
                                  "null"
                                ],
                                "description": "Whether the tool schema hash differs from the previous observed day; null when either is unknown."
                              },
                              "retry_reached_level": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "description": "Result of the same-day retry, when one was made."
                              },
                              "remotes": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        "missing_days": {
                          "type": "array",
                          "description": "Days since the first observation (within the last 30 days, before today UTC) with no observation row, and the recorded reason: not_in_registry, no_remote, remote_not_probeable, not_active, or no_observation.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "day": {
                                "type": "string",
                                "format": "date"
                              },
                              "reason": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "tools": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "description": "Tool names returned by tools/list in the latest successful observation (from scanner 0.4.0, 2026-10-20). Names only; descriptions are not stored. Names outside [A-Za-z0-9_.-/]{1,64} are omitted.",
                          "properties": {
                            "names": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "count": {
                              "type": "integer"
                            },
                            "partial": {
                              "type": "boolean",
                              "description": "true when tools/list announced more pages; only the first page is recorded."
                            },
                            "set_first_observed_at": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "format": "date-time",
                              "description": "When Lowdown first observed this exact set of tool names for the target."
                            },
                            "observed_at": {
                              "type": "string",
                              "format": "date-time"
                            }
                          }
                        },
                        "declared_vs_observed": {
                          "type": "object",
                          "description": "Declared and observed values side by side. No judgment is made.",
                          "properties": {
                            "declared_version": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "observed_server_version": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "declared_hosts": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "observed_hosts": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "method": {
                          "type": "object",
                          "description": "How the observations were made and what they do not show.",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "scanner_candidates": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Returned instead of `scanner` when a short name matches several scanned servers."
                    },
                    "interactions": {
                      "type": "integer"
                    },
                    "rated_interactions": {
                      "type": "integer",
                      "description": "Denominator of success_rate."
                    },
                    "protocol_requests": {
                      "type": "integer",
                      "description": "initialize, tools/list, ping and other non-tool requests (not in success_rate)."
                    },
                    "rejected_requests": {
                      "type": "integer",
                      "description": "Requests rejected as malformed, unknown tool, or invalid arguments (not in success_rate)."
                    },
                    "by_source": {
                      "type": "object",
                      "properties": {
                        "organic": {
                          "type": "integer"
                        },
                        "seeded": {
                          "type": "integer"
                        },
                        "synthetic": {
                          "type": "integer"
                        }
                      }
                    },
                    "success_rate_basis": {
                      "type": "string"
                    },
                    "success_rate": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Share of successes among rated interactions: organic tool calls and agent reports. Protocol requests, rejected requests, and seeded or synthetic records are excluded. null when there are none."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "none",
                        "low",
                        "medium",
                        "high"
                      ],
                      "description": "Based on rated_interactions (none = 0, low < 10, medium < 100, high >= 100)."
                    },
                    "avg_latency_ms": {
                      "type": "number"
                    },
                    "reviews": {
                      "type": "integer"
                    },
                    "avg_rating": {
                      "type": "number"
                    },
                    "review_conversion_rate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "failure_breakdown": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      },
                      "description": "Counts of reported failure types."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/interactions": {
      "post": {
        "operationId": "recordInteraction",
        "summary": "Record an interaction with an agent, tool, or service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "actor",
                  "target",
                  "target_type",
                  "task_type",
                  "outcome"
                ],
                "properties": {
                  "actor": {
                    "type": "string",
                    "description": "Your agent/system identifier",
                    "maxLength": 200
                  },
                  "target": {
                    "type": "string",
                    "description": "Identifier of what you used",
                    "maxLength": 200
                  },
                  "target_type": {
                    "type": "string",
                    "enum": [
                      "agent",
                      "tool",
                      "service",
                      "human"
                    ]
                  },
                  "task_type": {
                    "type": "string",
                    "description": "e.g. 'web_search', 'code_gen'",
                    "maxLength": 200
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "success",
                      "partial",
                      "failure"
                    ]
                  },
                  "latency_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600000
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "organic",
                      "seeded",
                      "synthetic"
                    ],
                    "description": "organic (default) for real use; synthetic for tests, including intentional failure tests."
                  },
                  "failure_type": {
                    "type": "string",
                    "enum": [
                      "invalid_arguments",
                      "protocol_error",
                      "timeout",
                      "server_error",
                      "tool_error",
                      "unknown"
                    ]
                  },
                  "request_kind": {
                    "type": "string",
                    "enum": [
                      "tool_call",
                      "protocol",
                      "reported"
                    ],
                    "description": "Default reported. The proxy sends tool_call / protocol."
                  },
                  "error_layer": {
                    "type": "string",
                    "enum": [
                      "request",
                      "server",
                      "tool"
                    ],
                    "description": "request = the request itself was rejected (malformed, unknown tool, invalid arguments); not counted in success_rate."
                  },
                  "node_id": {
                    "type": "string",
                    "pattern": "^ld_[0-9a-f]{12}$"
                  },
                  "server_version": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "schema_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8,64}$"
                  },
                  "recorder_version": {
                    "type": "string",
                    "maxLength": 32
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "More than 120 records per minute for this node_id (or actor)."
          }
        }
      },
      "get": {
        "operationId": "listInteractions",
        "summary": "List interactions recorded by one actor",
        "parameters": [
          {
            "name": "actor",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "task_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Interactions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/node/{node_id}": {
      "get": {
        "operationId": "getNodeStats",
        "summary": "Contribution stats of a lowdown-proxy node",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Node id created by lowdown-proxy (~/.lowdown/node.json), e.g. ld_..."
          }
        ],
        "responses": {
          "200": {
            "description": "Node stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "unknown"
                      ]
                    },
                    "contribution": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "interactions": {
                          "type": "integer"
                        },
                        "targets_observed": {
                          "type": "integer"
                        },
                        "active_days": {
                          "type": "integer"
                        },
                        "first_seen": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "last_seen": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "network": {
                      "type": "object",
                      "properties": {
                        "total_nodes": {
                          "type": "integer"
                        },
                        "total_interactions": {
                          "type": "integer"
                        }
                      }
                    },
                    "rank": {
                      "type": "object",
                      "properties": {
                        "percentile": {
                          "type": "integer"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
