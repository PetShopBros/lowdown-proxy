{
  "openapi": "3.1.0",
  "info": {
    "title": "Lowdown API",
    "description": "Query and record AI agent/tool interaction reputation data.",
    "version": "0.1.3"
  },
  "servers": [
    {
      "url": "https://lowdown-proxy.vercel.app"
    }
  ],
  "paths": {
    "/api/reputation/{target}": {
      "get": {
        "operationId": "getReputation",
        "summary": "Get reputation of an agent, tool, or service",
        "description": "Returns interaction history, success rate, and confidence level for the given target. Supports fuzzy matching — short names like 'brave-search' resolve automatically.",
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Identifier of the target. e.g. 'mcp:modelcontextprotocol/brave-search' or just 'brave-search'"
          },
          {
            "name": "ref",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" },
            "description": "Optional referral tag used to measure where lookups come from."
          }
        ],
        "responses": {
          "200": {
            "description": "Reputation data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "target": { "type": "string" },
                    "interactions": { "type": "integer" },
                    "success_rate": { "type": "number" },
                    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
                    "avg_latency_ms": { "type": "number" },
                    "review_count": { "type": "integer" },
                    "avg_rating": { "type": "number" },
                    "scanner": {
                      "type": "object",
                      "description": "Observations by Lowdown Scanner (initialize + tools/list only; no tool calls). Separate from interaction data; not included in success_rate. When the target is outside the Scanner's fixed set of 2,000 daily-observed MCP Registry entries, this block contains only `observed: false` and a note; absence of data says nothing about the target's status.",
                      "properties": {
                        "observed": { "type": "boolean", "description": "false when no Scanner observation exists for this target." },
                        "note": { "type": "string" },
                        "target": { "type": "string" },
                        "last_observed_at": { "type": "string", "format": "date-time" },
                        "observations_30d": { "type": "integer" },
                        "remotes_observed": { "type": "integer" },
                        "latest": {
                          "type": "object",
                          "properties": {
                            "reached_level": { "type": "integer", "enum": [0, 1, 2], "description": "0 = initialize failed, 1 = initialize ok, 2 = initialize + tools/list ok" },
                            "http_status": { "type": ["integer", "null"] },
                            "error_type": { "type": ["string", "null"] },
                            "latency_ms": { "type": ["integer", "null"] },
                            "tool_count": { "type": ["integer", "null"] },
                            "schema_hash": { "type": ["string", "null"] },
                            "server_version": { "type": ["string", "null"] }
                          }
                        },
                        "schema_versions_30d": { "type": "integer" },
                        "status_distribution_30d": { "type": "object", "additionalProperties": { "type": "integer" } }
                      }
                    },
                    "scanner_candidates": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Returned instead of `scanner` when a short name matches several scanned servers."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/interactions": {
      "post": {
        "operationId": "recordInteraction",
        "summary": "Record an interaction with an agent, tool, or service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["actor", "target", "target_type", "task_type", "outcome"],
                "properties": {
                  "actor": { "type": "string", "description": "Your agent/system identifier" },
                  "target": { "type": "string", "description": "Identifier of what you used" },
                  "target_type": { "type": "string", "enum": ["agent", "tool", "service", "human"] },
                  "task_type": { "type": "string", "description": "e.g. 'web_search', 'code_gen'" },
                  "outcome": { "type": "string", "enum": ["success", "partial", "failure"] },
                  "latency_ms": { "type": "integer" },
                  "source": { "type": "string", "enum": ["organic", "seeded", "synthetic"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}