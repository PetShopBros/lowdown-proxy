{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.PetShopBros/lowdown-proxy",
  "description": "Look up MCP Registry declarations, npm package status, and daily observations of MCP servers.",
  "repository": {
    "url": "https://github.com/PetShopBros/lowdown-proxy",
    "source": "github"
  },
  "version": "0.1.20",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lowdown-proxy",
      "version": "0.1.19",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://lowdown-proxy.vercel.app/mcp"
    }
  ]
}
