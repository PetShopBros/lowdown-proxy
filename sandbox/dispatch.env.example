# /etc/lowdown/dispatch.env (root, 600) — sandbox/dispatch.sh 가 읽는다
# GitHub → Settings → Developer settings → Fine-grained tokens
#   Repository access: Only select repositories → PetShopBros/lowdown-proxy
#   Permissions → Repository → Actions: Read and write (나머지는 없음)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=PetShopBros/lowdown-proxy
