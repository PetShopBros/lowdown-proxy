[Unit]
Description=Lowdown: build server cards hourly 13:07~18:07 KST (04:07~09:07 UTC, 상태 요약 UTC 03:37 갱신 뒤)

[Timer]
# 2026-11-12: 한 번에 몰아 만들지 않고 매시 나눠 만든다(실행마다 CARD_TIME_BUDGET_MIN 상한, 남은 대상은 다음 시각이 이어 감).
# 다 만들었으면 뒤 실행은 목록만 읽고 1분 안에 끝난다.
OnCalendar=*-*-* 04..09:07:00 UTC
AccuracySec=1s
# 꺼져 있던 동안 놓친 실행을 켜질 때 몰아서 하지 않는다(그때는 GitHub 예약이 예비로 돈다)
Persistent=false
Unit=lowdown-dispatch@cards.yml.service

[Install]
WantedBy=timers.target
