[Unit]
Description=Lowdown: build server cards at 00:07 KST (15:07 UTC, 예비 스캔 13:17·상태 요약 14:37 갱신 뒤)

[Timer]
OnCalendar=*-*-* 15:07:00 UTC
AccuracySec=1s
# 꺼져 있던 동안 놓친 실행을 켜질 때 몰아서 하지 않는다(그때는 GitHub 예약이 예비로 돈다)
Persistent=false
Unit=lowdown-dispatch@cards.yml.service

[Install]
WantedBy=timers.target
