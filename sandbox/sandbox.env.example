# /etc/lowdown/sandbox.env (root 소유, 600). 이 파일 내용은 대화·저장소 어디에도 붙이지 않는다.
LOWDOWN_SUPABASE_URL=https://<project>.supabase.co
# 샌드박스 전용 secret key 를 따로 만들어 넣는다(문제가 생기면 이 키만 폐기). 없으면 scanner key.
LOWDOWN_SANDBOX_KEY=
# 선택값 (기본값)
SANDBOX_CONCURRENCY=2
SANDBOX_MAX_TARGETS=400
SANDBOX_TIME_BUDGET_MIN=240
