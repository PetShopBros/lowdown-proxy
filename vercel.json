{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/agents.json",
      "destination": "/api/agents"
    },
    {
      "source": "/agents",
      "destination": "/api/page?kind=agents"
    },
    {
      "source": "/agents/:akind/:slug",
      "destination": "/api/page?kind=agent&akind=:akind&slug=:slug"
    },
    {
      "source": "/status.json",
      "destination": "/api/status"
    },
    {
      "source": "/.well-known/glama.json",
      "destination": "/public/.well-known/glama.json"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?kind=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/page?kind=terms"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/page?kind=home&nc=1"
    },
    {
      "source": "/",
      "destination": "/api/page?kind=home"
    },
    {
      "source": "/openapi.json",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/discovery?file=openapi.json&nc=1"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/discovery?file=openapi.json"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/discovery?file=robots.txt&nc=1"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/discovery?file=robots.txt"
    },
    {
      "source": "/menu.json",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/discovery?file=menu.json&nc=1"
    },
    {
      "source": "/menu.json",
      "destination": "/api/discovery?file=menu.json"
    },
    {
      "source": "/llms.txt",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/discovery?file=llms.txt&nc=1"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/discovery?file=llms.txt"
    },
    {
      "source": "/servers",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/page?kind=index&nc=1"
    },
    {
      "source": "/servers",
      "destination": "/api/page?kind=index"
    },
    {
      "source": "/servers/:ns/:name",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/page?kind=server&ns=:ns&name=:name&nc=1"
    },
    {
      "source": "/servers/:ns/:name",
      "destination": "/api/page?kind=server&ns=:ns&name=:name"
    },
    {
      "source": "/sitemaps/:file",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/page?kind=sitemap-part&file=:file&nc=1"
    },
    {
      "source": "/sitemaps/:file",
      "destination": "/api/page?kind=sitemap-part&file=:file"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/page?kind=sitemap&nc=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?kind=sitemap"
    },
    {
      "source": "/api/find",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/find?nc=1"
    },
    {
      "source": "/api/reputation/:ns/:name",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/reputation/_slash?t=:ns/:name&nc=1"
    },
    {
      "source": "/api/reputation/:ns/:name",
      "destination": "/api/reputation/_slash?t=:ns/:name"
    },
    {
      "source": "/api/reputation/:target",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Claude-User|ChatGPT-User|Perplexity-User|Claude-SearchBot|OAI-SearchBot).*" }],
      "destination": "/api/reputation/:target?nc=1"
    }
  ]
}
