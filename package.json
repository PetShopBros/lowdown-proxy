{
  "name": "lowdown-proxy",
  "version": "0.1.19",
  "mcpName": "io.github.PetShopBros/lowdown-proxy",
  "description": "Record and query AI agent/tool/service interactions. Shared interaction history for the multi-agent ecosystem.",
  "type": "module",
  "bin": {
    "lowdown-proxy": "dist/cli.js",
    "lowdown-mcp": "dist/mcp-server.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsx src/cli.ts",
    "scanner:typecheck": "tsc -p scanner",
    "scanner:test": "node --test scanner/lib.test.ts scanner/registry-diff.test.ts scanner/first-seen.test.ts scanner/archive.test.ts scanner/reputation.test.ts scanner/report.test.ts scanner/tool-defs.test.ts scanner/market.test.ts scanner/private-archive.test.ts scanner/npm.test.ts",
    "scanner:dry": "node scanner/scan.ts --dry-run --limit=30",
    "test": "npm run build && node --test test/p0.test.ts"
  },
  "keywords": [
    "mcp",
    "ai-agent",
    "reputation",
    "interaction",
    "proxy",
    "trust",
    "lowdown"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/node": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
